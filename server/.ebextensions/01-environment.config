# Elastic Beanstalk configuration (Node.js 22 on Amazon Linux 2023).
# Secrets (JWT_SECRET, INTERNAL_API_TOKEN, DB_SECRET_ARN ...) are set as environment
# properties in the console / CLI - never committed here.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    DB_SSL: true
    IN_PROCESS_REMINDERS: false

  # Load balancer health check hits the API, which also checks the database
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    Port: 8080
    Protocol: HTTP
    MatcherHTTPCode: 200

  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application

  # High availability: 2-4 instances across two AZs
  aws:autoscaling:asg:
    MinSize: 2
    MaxSize: 4
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: 70
    LowerThreshold: 25

  # Zero-downtime deploys with automatic rollback on failed health checks
  aws:elasticbeanstalk:command:
    DeploymentPolicy: RollingWithAdditionalBatch
    BatchSizeType: Fixed
    BatchSize: 1
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # Ship application logs to CloudWatch Logs
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14
