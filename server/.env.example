# ---------------------------------------------------------------------------
# Local development - copy to .env. Every AWS setting is optional; when it is
# empty the app uses a local fallback (console email, local uploads, memory cache).
# On Elastic Beanstalk, set these as environment properties instead.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173

# Required in production (use a long random string)
JWT_SECRET=dev-only-secret-change-me
# Shared secret the Lambda functions send in X-Internal-Token
INTERNAL_API_TOKEN=dev-internal-token

# --- Database (pick one) -----------------------------------------------------
DATABASE_URL=postgres://library:library@localhost:5433/library
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:library/db
# DATABASE_READ_URL=postgres://user:pass@replica-host:5432/library   # RDS read replica
# DB_SSL=true                                                         # required for RDS

# --- AWS integrations ----------------------------------------------------------
AWS_REGION=ap-south-1
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/library-notifications
# SES_FROM_EMAIL=library@your-verified-domain.com
# SES_DIRECT=false          # true = send via SES directly from the app (no SQS/Lambda)
# S3_BUCKET=library-covers-123456789012
# REDIS_URL=redis://localhost:6379                                     # ElastiCache endpoint

# --- Library rules -------------------------------------------------------------
PICKUP_WINDOW_HOURS=48
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_RESERVATIONS=5
MAX_RENEWALS=1
LIBRARY_TIMEZONE=Asia/Thimphu

# In AWS, EventBridge triggers reminders; locally the server does it hourly
IN_PROCESS_REMINDERS=true
SEED_ON_START=false
