# ---------------------------------------------------------------------------
# Local development - copy to .env. Every AWS setting is optional; when it is
# empty the app uses a local fallback (console email, local uploads, memory cache).
# On Elastic Beanstalk, set these as environment properties instead.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173

# Required in production (use a long random string)
JWT_SECRET=dev-only-secret-change-me
# Shared secret the Lambda functions send in X-Internal-Token
INTERNAL_API_TOKEN=dev-internal-token

# Proxies in front of the app (CloudFront -> ALB = 2). Sets Express "trust proxy".
# TRUST_PROXY_HOPS=2

# --- Database (pick one) -----------------------------------------------------
DATABASE_URL=postgres://library:library@localhost:5433/library
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:rds!db-...   # + DB_HOST, DB_NAME
# DB_HOST=library-db.xxxx.us-east-1.rds.amazonaws.com
# DB_NAME=library
# SECRET_CACHE_TTL_SECONDS=300   # rotated passwords are picked up within this time (or at once on auth failure)
# DB_READ_HOST=library-db-replica.xxxx.us-east-1.rds.amazonaws.com   # RDS read replica, same secret
# DATABASE_READ_URL=postgres://user:pass@replica-host:5432/library   # older option: password in the URL
# DB_SSL=true        # RDS: TLS verified against certs/rds-global-bundle.pem (no-verify = don't check)
# DB_SSL_CA=/path/to/other-ca.pem

# --- AWS integrations ----------------------------------------------------------
AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/library-notifications
# SES_FROM_EMAIL=library@your-verified-domain.com
# SES_DIRECT=false          # true = send via SES directly from the app (no SQS/Lambda)
# S3_BUCKET=library-covers-123456789012
# REDIS_URL=redis://localhost:6379                                     # ElastiCache endpoint

# --- Library rules -------------------------------------------------------------
PICKUP_WINDOW_HOURS=48
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_RESERVATIONS=5
MAX_RENEWALS=1
LIBRARY_TIMEZONE=Asia/Thimphu

# In AWS, EventBridge triggers reminders; locally the server does it hourly
IN_PROCESS_REMINDERS=true
SEED_ON_START=false
